{
  "name": "heera/agentimus",
  "description": "Make any WordPress site legible to AI agents and crawlers. Reference implementation of the WP_Discovery protocol.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "automattic/jetpack-autoloader": "^5.0",
    "wordpress/mcp-adapter": "^0.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "phpunit -c phpunit-integration.xml.dist"
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "automattic/jetpack-autoloader": true
    }
  }
}
