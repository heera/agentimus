{
  "name": "agentimus",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 3 admin app for the Agentimus WordPress plugin.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run build:public",
    "build:public": "esbuild resources/public/*.js --minify --charset=ascii --legal-comments=none --outdir=assets --log-level=warning"
  },
  "dependencies": {
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "esbuild": "^0.21.5",
    "vite": "^5.2.0"
  }
}
