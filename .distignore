# Files & folders excluded from the distributed plugin ZIP / SVN.
# What SHIPS: agentimus.php, uninstall.php, readme.txt, LICENSE, inc/,
# assets/ (built), resources/ (Vue source) + vite.config.js + package.json
# (so the build is reproducible and the source is human-readable).

/.git
/.github
/.gitignore
/.distignore
/.editorconfig
/.wordpress-org
/.dev
/.claude
/dev
/docs
/node_modules
/vendor
/tests
/bin
/phpunit.xml.dist
/phpunit-integration.xml.dist
/composer.json
/composer.lock
/package-lock.json
/README.md
/RELEASING.md
/.preview.html
